{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kazuki Bot",
      "detail": "Botu VS Code terminalinde başlatır, dosyalar değişince otomatik yeniden başlatır",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      }
    }
  ]
}
